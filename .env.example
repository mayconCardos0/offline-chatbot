# ─────────────────────────────────────────────
# Offline Chatbot — environment variables
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────

# Server
PORT=8000                          # TCP port the FastAPI server listens on

# LLM (llama-cpp-python)
MODEL_PATH=models/gemma-2-2b-it-Q4_K_M.gguf    # Path to the GGUF model file (relative to project root)
N_CTX=4096                         # Context window size (tokens)
N_THREADS=4                        # CPU threads used for inference
N_GPU_LAYERS=0                     # Number of layers offloaded to GPU (0 = CPU only)

# Embeddings (sentence-transformers)
EMBED_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2  # HuggingFace model name for embeddings
EMBED_CACHE_DIR=models                      # Directory where the embedding model is cached
EMBED_BATCH_SIZE=32         # Lotes menores = menor pico de RAM na RPi
EMBED_DISK_CACHE=true       # Cacheia embeddings em disco (acelera reinicializações)

# RAG
DOCS_DIR=data/documents            # Directory containing source documents to index
INDEX_DIR=data/index               # Directory where the FAISS index is persisted
TOP_K=4                            # Number of chunks to retrieve per query

# Chunking
CHUNK_SIZE=500                     # Maximum characters per chunk
CHUNK_OVERLAP=100                  # Overlap characters between consecutive chunks

# Conversations
CONVERSATIONS_FILE=data/conversations.json  # JSON file for persisting session history

# Logging
LOG_LEVEL=INFO                     # Logging level: DEBUG | INFO | WARNING | ERROR
